{
  "$schema": "storywalkers/design-tokens@1",
  "meta": {
    "name": "StoryWalkers — onboarding (/start/*)",
    "version": "1.0.0",
    "source": {
      "frames": "design/figma/s1.png … s5.png, design/figma/elements.png",
      "figma_file": "BNvBqw0d9jFJhFVCKgVkuS (Storywalkers (Copy))",
      "figma_file_original": "1LOfrhVsf10oVdmiMNQqOa",
      "method": "pixel measurement of the exported frames (1440px wide) + the values already implemented in frontend/src/routes/start/startTheme.css"
    },
    "measured_on": "2026-11-17"
  },

  "color": {
    "brand": {
      "orange": { "value": "#e95002", "note": "gradient start, main button left edge" },
      "red": { "value": "#d91617", "note": "gradient end, main button right edge" },
      "redStroke": { "value": "#de3234", "note": "1px stroke of selected chips and tiles" },
      "redSoft": { "value": "#fbe7e7", "note": "fill of selected chip / secondary 'no' tile / 'Итого' row" },
      "redHover": { "value": "#f0510a", "note": "hover gradient start (implementation value)" }
    },
    "surface": {
      "page": { "value": "#ffffff" },
      "card": { "value": "#ffffff" },
      "subtle": { "value": "#f9f9f9", "note": "idle chip and idle tile fill" },
      "ghost": { "value": "#f4f4f4" },
      "disabled": { "value": "#ececec" }
    },
    "text": {
      "primary": { "value": "#000000", "note": "the frames use true black, not #111111" },
      "secondary": { "value": "#606060", "note": "lead paragraphs" },
      "muted": { "value": "#8a8a8a", "note": "placeholders, summary labels" },
      "disabled": { "value": "#b0b0b0" },
      "onBrand": { "value": "#ffffff" }
    },
    "border": {
      "ink": { "value": "#000000", "note": "2px card outline" },
      "line": { "value": "#dbdbdb", "note": "1px inputs, tiles, dropdown, summary rows" },
      "disabled": { "value": "#e3e3e3" },
      "focus": { "value": "#de3234" }
    },
    "decor": {
      "halftone": { "value": "#bcbcbc", "note": "dot grid used as the card shadow" },
      "tape": { "value": "#e5e5e5" }
    }
  },

  "gradient": {
    "brandHorizontal": {
      "value": "linear-gradient(90deg, #e95002 0%, #d91617 100%)",
      "note": "main button and inline callout card; measured on s1 and s5"
    },
    "brandVertical": {
      "value": "linear-gradient(180deg, #e95102 0%, #dd2412 100%)",
      "note": "right-rail 'ИНФОРМАЦИЯ О КАНАЛЕ' card; measured top vs bottom"
    },
    "brandHorizontalHover": {
      "value": "linear-gradient(90deg, #f0510a 0%, #cf1518 100%)"
    }
  },

  "type": {
    "family": {
      "display": { "value": "\"Unbounded\", \"Russo One\", \"Inter\", system-ui, sans-serif" },
      "body": { "value": "\"Inter\", system-ui, sans-serif" }
    },
    "headingLg": { "size": "24px", "weight": 600, "lineHeight": "1.25", "tracking": "0.01em", "color": "brand.red", "note": "cap height 17px measured in s1" },
    "headingMd": { "size": "20px", "weight": 600, "lineHeight": "1.3", "tracking": "0.01em", "color": "brand.red" },
    "body": { "size": "16px", "weight": 400, "lineHeight": "1.55", "color": "text.primary", "note": "x-height 13px measured" },
    "bodySm": { "size": "13px", "weight": 400, "lineHeight": "1.5", "color": "text.secondary" },
    "label": { "size": "11px", "weight": 600, "tracking": "0.10em", "casing": "uppercase", "note": "stepper chips, summary labels, card eyebrows" },
    "button": { "size": "12px", "weight": 600, "tracking": "0.06em", "casing": "uppercase" },
    "buttonSm": { "size": "10.5px", "weight": 600, "casing": "none" }
  },

  "radius": {
    "chip": { "value": "6px", "note": "stepper chip, tiles, inputs, dropdown, summary rows" },
    "card": { "value": "21px", "note": "measured on the 1440 frame; card uses 32px today" },
    "railCard": { "value": "24px", "note": "right-rail cards; measured approx" },
    "pill": { "value": "999px", "note": "primary and secondary buttons" },
    "check": { "value": "3px" }
  },

  "size": {
    "controlHeight": { "value": "50px", "note": "buttons and inputs" },
    "chipHeight": { "value": "37px", "note": "stepper chip incl. 1px stroke" },
    "cardBorder": { "value": "2px", "note": "solid ink outline around the main card" },
    "contentWidth": { "value": "852px", "note": "card inner width on a 1440 frame (x 93…945)" },
    "railWidth": { "value": "367px", "note": "right rail card width (x 985…1352)" },
    "frameGutter": { "value": "40px", "note": "gap between the main card and the rail" },
    "pagePad": { "value": "56px", "note": "frame padding, top and left" }
  },

  "space": {
    "2xs": "4px",
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px",
    "rhythm": {
      "note": "measured block gaps inside the card on s1",
      "cardPadTop": "56px",
      "stepperToMedia": "64px",
      "mediaToHeading": "32px",
      "headingToLead": "12px",
      "leadToTiles": "26px",
      "tilesToCta": "24px",
      "ctaToCardBottom": "48px"
    }
  },

  "elevation": {
    "halftone": {
      "value": "radial-gradient(#bcbcbc 0.7px, transparent 0.8px), 3px 3px",
      "note": "1px dot on a 3px grid, 22px tall strip under the card, inset 6px from each side, radius 0 0 30px 30px"
    },
    "ctaGlow": { "value": "0 8px 18px -8px rgba(217, 26, 28, 0.65)" },
    "dropdown": { "value": "0 12px 24px -12px rgba(0, 0, 0, 0.25)" },
    "none": { "note": "no blur shadows on cards, tiles or inputs" }
  },

  "motion": {
    "fast": { "value": "150ms", "easing": "ease" },
    "enter": { "value": "350ms", "easing": "ease-out", "from": "translateY(8px), opacity 0" },
    "press": { "value": "translateY(1px) / scale(0.99)" },
    "reducedMotion": { "note": "all transitions and enter animations are disabled under prefers-reduced-motion" }
  },

  "component": {
    "buttonPrimary": { "height": "50px", "radius": "pill", "fill": "gradient.brandHorizontal", "label": "type.button", "shadow": "elevation.ctaGlow", "disabled": "linear-gradient(90deg,#b9b9b9,#7c7c7c) / #e6e6e6 text" },
    "buttonSecondary": { "height": "50px", "radius": "pill", "fill": "#ffffff", "border": "1px #f08a5d", "hover": "border+text brand.red", "disabled": "1px #dcdcdc / #b5b5b5 text" },
    "stepper": { "gap": "8px", "connector": "1px dashed #dbdbdb (solid #de3234 once reached)", "stateIdle": "1px dashed #dbdbdb on #f9f9f9", "stateActive": "1px solid #de3234 on #fbe7e7", "stateDone": "same as active, weight 600" },
    "tile": { "height": "50px", "radius": "chip", "fill": "#f9f9f9", "border": "1px #dbdbdb", "selected": "#fbe7e7 + #de3234", "disabled": "#ececec / #b0b0b0" },
    "input": { "height": "50px", "radius": "chip", "fill": "#ffffff", "border": "1px #dbdbdb", "focus": "border ink", "error": "border #de3234, text brand.red", "placeholder": "italic, text.muted" },
    "checkbox": { "size": "16px", "radius": "3px", "border": "1px #9a9a9a", "checked": "#e95002 + white tick" },
    "select": { "trigger": "as input, weight 600", "open": "trigger bottom radii 0, list shares the border, max-height 168px" },
    "callout": { "radius": "chip", "fill": "gradient.brandHorizontal", "text": "onBrand", "note": "inline congratulation card in s5" },
    "railCard": { "radius": "railCard", "brand": "gradient.brandVertical", "neutral": "#ffffff with 2px ink outline", "content": "label/value pairs separated by 1px rgba(255,255,255,.35) hairlines" }
  }
}
