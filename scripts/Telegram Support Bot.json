      "parameters": {
        "jsCode": "const msg = $json.message ?? $json.edited_message ?? null;\n\nif (!msg) return [];\n\nconst ADMIN_CHAT_ID = -1003896283228; // <-- REPLACE WITH YOUR ADMIN CHAT ID\nconst FIRESTORE_PROJECT_ID = 'storywalkers-b4fdf'; // <-- REPLACE WITH YOUR GOOGLE CLOUD PROJECT ID\nconst FIRESTORE_DATABASE = 'pathways';\nconst FIRESTORE_COLLECTION = 'tg_support';\n\nreturn [{\n  json: {\n    adminChatId: ADMIN_CHAT_ID,\n    firestoreProjectId: FIRESTORE_PROJECT_ID,\n    firestoreDatabase: FIRESTORE_DATABASE,\n    firestoreCollection: FIRESTORE_COLLECTION,\n    updateId: $json.update_id,\n    messageId: msg.message_id,\n    text: msg.text ?? '',\n    chatId: msg.chat?.id,\n    chatType: msg.chat?.type,\n    fromId: msg.from?.id,\n    username: msg.from?.username ?? '',\n    firstName: msg.from?.first_name ?? '',\n    lastName: msg.from?.last_name ?? '',\n    hasUsername: Boolean(msg.from?.username),\n    isPrivate: msg.chat?.type === 'private',\n    isAdminChat: msg.chat?.id === ADMIN_CHAT_ID\n  }\n}];"
      },
