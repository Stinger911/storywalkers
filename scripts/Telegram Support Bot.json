    {
      "parameters": {
        "jsCode": "const fullName = [$json.firstName, $json.lastName].filter(Boolean).join(' ');\nconst usernameNormalized = ($json.username || '').toLowerCase();\nconst firestoreUpsertUrl = 'https://firestore.googleapis.com/v1/projects/'\n  + $json.firestoreProjectId\n  + '/databases/'\n  + $json.firestoreDatabase\n  + '/documents/'\n  + $json.firestoreCollection\n  + '/'\n  + usernameNormalized;\n\nconst firestoreBody = {\n  fields: {\n    userId: { stringValue: String($json.fromId) },\n    username: { stringValue: usernameNormalized },\n    lastMessage: { stringValue: $json.text || '' },\n    firstName: { stringValue: $json.firstName || '' },\n    lastName: { stringValue: $json.lastName || '' },\n    updatedAt: { timestampValue: new Date().toISOString() },\n  }\n};\n\nconst replyTarget = $json.username ? $json.username : $json.fromId;\nconst adminText = [\n  '📩 Новое сообщение в саппорт',\n  '',\n  '👤 Пользователь: ' + (fullName || 'Без имени'),\n  '🆔 UserID: ' + $json.fromId,\n  '🔗 Username: ' + ($json.username ? '@' + $json.username : 'нет'),\n  '💬 Сообщение:',\n  $json.text || '',\n  '',\n  '↩️ Ответ:',\n  '`/reply ' + replyTarget + ' \"текст ответа\"`',\n].join('\\n');\n\nreturn [{\n  json: {\n    ...$json,\n    usernameNormalized,\n    firestoreUpsertUrl,\n    firestoreBody,\n    adminText,\n    lastMessage: firestoreBody.fields.lastMessage.stringValue,\n    updatedAt: firestoreBody.fields.updatedAt.timestampValue,\n  }\n}];"
      },
      "id": "2444ec98-6a0a-4557-b81d-f6b980f1043a",
