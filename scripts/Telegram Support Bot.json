    {
      "parameters": {
        "jsCode": "const text = ($json.text || '').trim();\nconst match = text.match(/^\\/reply\\s+([^\\s]+)\\s+\"([\\s\\S]+)\"$/);\n\nif (!match) {\n  return [{\n    json: {\n      ...$json,\n      parseOk: false,\n      errorText: 'Неверный формат.\\nИспользуй:\\n/reply <userid|username> \"сообщение\"'\n    }\n  }];\n}\n\nlet targetRaw = match[1].trim();\nconst replyText = match[2].trim();\n\nif (targetRaw.startsWith('@')) {\n  targetRaw = targetRaw.slice(1);\n}\n\nconst lookupUsernameNormalized = targetRaw.toLowerCase();\nconst targetIsNumeric = /^\\d+$/.test(targetRaw);\nconst firestoreLookupUrl = `https://firestore.googleapis.com/v1/projects/${$json.firestoreProjectId}/databases/${$json.firestoreDatabase}/documents/${$json.firestoreCollection}/${lookupUsernameNormalized}`;\n\nreturn [{\n  json: {\n    ...$json,\n    parseOk: true,\n    targetRaw,\n    replyText,\n    targetIsNumeric,\n    lookupUsernameNormalized,\n    firestoreLookupUrl,\n  }\n}];"
      },
