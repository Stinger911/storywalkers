    {
      "parameters": {
        "jsCode": "const input = $json || {};\n\nconst firestoreUserId = input.fromId || null;\nconst firestoreLastMessage = input.lastMessage || '';\n\nif (!firestoreUserId) {\n  return [{\n    json: {\n      ...input,\n      resolveOk: false,\n      errorText: `Не удалось найти пользователя: ${input.targetRaw}\\nПроверь username и убедись, что пользователь уже писал боту в личку.`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...input,\n    resolveOk: true,\n    targetUserId: String(firestoreUserId),\n    firestoreLastMessage,\n  }\n}];"
      },
