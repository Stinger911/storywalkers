      "parameters": {
        "jsCode": "// Build a goal title lookup from whichever branch reached this node.\nconst GOALS = {};\nconst goalItems = $(\"Get goals\").isExecuted\n  ? $(\"Get goals\").all()\n  : $(\"Get goals1\").all();\nfor (const goal of goalItems) {\n  GOALS[goal.json._id] = goal.json.title;\n}\n\nconst staticData = $getWorkflowStaticData(\"global\");\nstaticData.studentSheetSync = staticData.studentSheetSync || {};\nconst syncCache = staticData.studentSheetSync;\nconst webhookQuery = $(\"Webhook\").isExecuted ? ($(\"Webhook\").item.json.query || {}) : {};\nconst forceSync = webhookQuery.force === \"1\" || webhookQuery.force === \"true\";\n\nfunction normalizeTimestamp(value) {\n  if (!value) return \"\";\n  if (typeof value === \"string\") return value;\n  if (typeof value.toISO === \"function\") return value.toISO();\n  if (typeof value.toMillis === \"function\") return new Date(value.toMillis()).toISOString();\n  if (typeof value.seconds === \"number\") return new Date(value.seconds * 1000).toISOString();\n  if (typeof value._seconds === \"number\") return new Date(value._seconds * 1000).toISOString();\n  return JSON.stringify(value);\n}\n\nfunction hasCompletedQuestionnaire(user, profileForm) {\n  if (user.telegramEvents && typeof user.telegramEvents === \"object\" && user.telegramEvents.questionnaireCompletedAt) {\n    return true;\n  }\n  const telegram = typeof profileForm.telegram === \"string\" ? profileForm.telegram.trim() : \"\";\n  if (!telegram) return false;\n  const about = typeof profileForm.aboutMe === \"string\" ? profileForm.aboutMe.trim() : \"\";\n  const notes = typeof profileForm.notes === \"string\" ? profileForm.notes.trim() : \"\";\n  return profileForm.submitted === true || Boolean(about || notes);\n}\n\nfunction stableStringify(value) {\n  if (value === null || typeof value !== \"object\") return JSON.stringify(value);\n  if (Array.isArray(value)) return \"[\" + value.map(stableStringify).join(\",\") + \"]\";\n  return \"{\" + Object.keys(value).sort().map((key) => JSON.stringify(key) + \":\" + stableStringify(value[key])).join(\",\") + \"}\";\n}\n\nfunction hashString(value) {\n  let hash = 0x811c9dc5;\n  for (let index = 0; index < value.length; index++) {\n    hash ^= value.charCodeAt(index);\n    hash = Math.imul(hash, 0x01000193) >>> 0;\n  }\n  return hash.toString(16).padStart(8, \"0\");\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const profileForm = item.json.profileForm && typeof item.json.profileForm === \"object\"\n    ? item.json.profileForm\n    : {};\n  const goal = item.json.selectedGoalId;\n\n  item.json.telegram_id = profileForm.telegram || \"\";\n  item.json.notes = profileForm.notes || profileForm.aboutMe || \"\";\n  item.json.goal = GOALS[goal] || goal || \"\";\n  item.json.registration = normalizeTimestamp(item.json.createdAt);\n  item.json.questionnaireCompleted = hasCompletedQuestionnaire(item.json, profileForm) ? \"Yes\" : \"No\";\n\n  const exportedRow = {\n    email: item.json.email || \"\",\n    Registration: item.json.registration,\n    Name: item.json.displayName || \"\",\n    Telegram: item.json.telegram_id,\n    About: item.json.notes,\n    Goals: item.json.goal,\n    Status: item.json.status || \"\",\n    questionnaireCompleted: item.json.questionnaireCompleted,\n  };\n\n  const syncKey = item.json._id || item.json.uid || item.json.email;\n  if (!syncKey) {\n    output.push(item);\n    continue;\n  }\n\n  const signature = hashString(stableStringify(exportedRow));\n  if (forceSync || syncCache[syncKey] !== signature) {\n    item.json._sheetSyncKey = syncKey;\n    item.json._sheetSyncSignature = signature;\n    output.push(item);\n  }\n}\n\nreturn output;"
      },
