APP_NAME=Personalized Learning Pathways API
APP_VERSION=0.1.0
ENV=local
FIREBASE_PROJECT_ID=
AUTH_REQUIRED=true
GIT_COMMIT=
BUILD_TIME=
# YouTube Data API v3 key for the public onboarding channel lookup.
# Without it /api/public/youtube/channel answers 502 and the student enters
# the channel numbers manually.
YOUTUBE_API_KEY=
YOUTUBE_LOOKUP_TIMEOUT_SECONDS=10
YOUTUBE_CHANNEL_CACHE_HOURS=24
YOUTUBE_LOOKUP_RATE_LIMIT_PER_MINUTE=20
